+// getCommand returns the command for the next block. It normally blocks until the
+// command queue has a batch or the view times out. When empty blocks are enabled and
+// the chain still holds an uncommitted command, it does not block: it proposes
+// whatever is queued -- including an empty command -- because a chained consensus
+// only commits a block once its successors are chained on top of it, and waiting for
+// the view to time out would delay that commit by a full view. (COTTON-NET)
+func (cs *consensusBase) getCommand(cert hotstuff.SyncInfo) (hotstuff.Command, bool) {
+	if cs.opts.ShouldProposeEmptyBlocks() && cs.hasUncommittedCommand(cert) {
+		ctx, cancel := context.WithCancel(cs.eventLoop.Context())
+		cancel() // do not block: take whatever the queue already holds
+		cmd, _ := cs.commandQueue.Get(ctx)
+		return cmd, true
+	}
+	ctx, cancel := synchronizer.TimeoutContext(cs.eventLoop.Context(), cs.eventLoop)
+	defer cancel()
+	return cs.commandQueue.Get(ctx)
+}
+
+// hasUncommittedCommand walks the chain from the certified block down to the last
+// committed block, looking for a block that carries commands. While one exists, the
+// leader must keep chaining successors onto it. This is both the trigger and the
+// brake for empty blocks: once the last command-carrying block commits, the walk
+// returns false and the chain stops growing. (COTTON-NET)
+func (cs *consensusBase) hasUncommittedCommand(cert hotstuff.SyncInfo) bool {
+	qc, ok := cert.QC()
+	if !ok {
+		return false
+	}
+	committed := cs.CommittedBlock().View()
+	block, ok := cs.blockChain.LocalGet(qc.BlockHash())
+	for ok && block.View() > committed {
+		if len(block.Command()) > 0 {
+			return true
+		}
+		block, ok = cs.blockChain.LocalGet(block.Parent())
+	}
+	return false
+}
